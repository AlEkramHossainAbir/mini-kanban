# Frontend environment — copy to .env.local for local (non-Docker) development.
# Both variables are read by next.config.mjs / the client bundle at BUILD time,
# not at run time, so changing either one requires a rebuild (`npm run build`)
# — see next.config.mjs's docblock and mini-kanban-frontend/ROADMAP.md Phase 2.

# Where the Next.js server proxies /api/v1/* to. Server-side only and
# deliberately NOT NEXT_PUBLIC_*: the browser must only ever see one origin,
# which is what keeps the SameSite=Lax auth cookies first-party (PLAN §1).
#   local dev → http://localhost:4000
#   docker    → http://backend:4000   (passed as a build ARG, see docker-compose.yml)
BACKEND_URL=http://localhost:4000

# Socket.IO connects DIRECTLY to the backend rather than through the rewrite
# above, so this address is resolved by the browser and must be publicly
# reachable. In a split deployment set it to the API's public origin.
NEXT_PUBLIC_WS_URL=http://localhost:4000
